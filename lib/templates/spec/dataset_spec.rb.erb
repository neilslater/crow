# frozen_string_literal: true

require 'helpers'

describe '<%= full_class_name_ruby %>' do
<% unless spec_fixture_error -%>
  subject(:instance) { class_under_test.new(<%= spec_arguments.map(&:inspect).join(', ') %>) }

<% end -%>
  let(:class_under_test) { <%= full_class_name_ruby %> }

  it 'is a valid Class' do
    expect(class_under_test).to be_a Class
  end

  describe '.new' do
<% if spec_fixture_error -%>
    it 'requires a user constructor fixture' do
      skip <%= spec_fixture_error.inspect %>
    end
<% else -%>
    it 'instantiates a <%= full_class_name_ruby %>' do
      expect(instance).to be_a class_under_test
    end
<% testable_attributes.each do |attribute| -%>

    it '<%= attribute.ruby_name %> has its configured value' do
<% if spec_expectation_error(attribute) -%>
      skip <%= "Supply a user expectation for #{attribute.ruby_name}: #{spec_expectation_error(attribute)}".inspect %>
<% else -%>
      expect(instance.<%= attribute.ruby_name %>).to eq <%= spec_expected(attribute) %>
<% end -%>
    end
<% end -%>
<% end -%>
  end
end
